# Environment variables; only non-secret templates may be tracked.
.env
.env.*
!.env.example
!.env.*.example

# Python virtual environments and caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Private local state, editor settings and generated application data
.local/
.vscode/
node_modules/
chroma_db/
uploads/
storage/

# Logs and recovery artifacts
*.log
*.dump
*.backup
