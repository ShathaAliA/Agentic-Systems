# ============================================================
# .env.example — Documents & AI (Local Development)
# Copy to .env, fill real values. NEVER commit .env.
# For PRODUCTION: use secrets files (DATABASE_URL_FILE, etc.)
# ============================================================

# --- App / Environment ---
APP_ENV=development
AUTH_MODE=development_password

# --- Auth session limits ---
AUTH_SESSION_SECONDS=900
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_GLOBAL_LIMIT=100

# --- Central DB (FastAPI runtime — restricted role) ---
# ⚠️ LOCAL DEV: use direct URL. PROD: use DATABASE_URL_FILE.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/wadi_db
CENTRAL_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/wadi_db

# --- DB host/port (per-department engines) ---
DB_HOST=127.0.0.1
DB_PORT=5435

# --- Provisioning worker (CLI only — NOT used by FastAPI runtime) ---
# ⚠️ LOCAL DEV: direct URLs. PROD: use *_FILE.
PROVISIONING_REGISTRY_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/wadi_db
PROVISIONING_ADMIN_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/postgres
TENANT_CONTRACT_FILE=./tenant-contract.json
DEPARTMENT_CREDENTIALS_DIR=./.credentials
PROVISIONING_MAX_ATTEMPTS=3

# --- LLM provider (openai | gemini) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_PRICING_REVISION=v1
LLM_INPUT_MICRO_USD_PER_MILLION=150
LLM_OUTPUT_MICRO_USD_PER_MILLION=600
# LLM_CACHED_INPUT_MICRO_USD_PER_MILLION=

# --- LLM API keys (pick one) ---
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-gemini-key-here

# --- Legacy (HR/Finance — only if testing legacy) ---
HR_DB_USER=hr_user
HR_DB_PASSWORD=hr_password
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=finance_password