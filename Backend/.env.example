# NON-SECRET TEMPLATE. Never add real credentials here.
APP_ENV=development
# Disabled unless explicitly opted in on a local development machine.
AUTH_MODE=disabled


# AUTH_MODE=development_password
AUTH_SESSION_SECONDS=900
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_GLOBAL_LIMIT=100

# Private JSON files containing {"url": "..."}; use separate credentials.
# FastAPI: restricted central application role, never PostgreSQL admin/provisioner.
DATABASE_URL_FILE=/run/secrets/api-database.json
DEPARTMENT_CREDENTIALS_DIR=/private/tenant-credentials
# Native runtime: set these explicitly for the development PostgreSQL server.
DB_HOST=127.0.0.1
DB_PORT=5435
# Offline processes ONLY. Do not mount these into FastAPI containers.
# CENTRAL_MIGRATION_DATABASE_URL_FILE=/private/central-migration.json
# AUTH_BOOTSTRAP_DATABASE_URL_FILE=/private/auth-enrollment.json
# PROVISIONING_REGISTRY_URL_FILE=/private/registry.json
# PROVISIONING_ADMIN_URL_FILE=/private/provisioner.json
# TENANT_CONTRACT_FILE=/private/tenant-contract.json
# PROVISIONING_MAX_ATTEMPTS=3
