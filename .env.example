# NON-SECRET COMPOSE TEMPLATE. These are paths and local development settings.
# Copy privately to .env only when using Compose; never commit its real contents.
# docker-compose.yml also requires POSTGRES_PASSWORD from a private operator source.
# Do not print expanded `docker compose config`: it can reveal that password.
AUTH_MODE=disabled
AUTH_SESSION_SECONDS=900
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_GLOBAL_LIMIT=100
API_URL_FILE=./.local/api.json
REGISTRY_URL_FILE=./.local/registry.json
PROVISIONER_URL_FILE=./.local/provisioner.json
TENANT_CONTRACT_FILE=./Backend/tenant-contract.example.json
DAY1_STATE_VOLUME=ai_platform_day1_dev_state
